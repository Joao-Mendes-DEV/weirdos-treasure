# Modelo das variáveis de ambiente. Copie para ".env" e preencha.
# NUNCA envie o arquivo .env para o GitHub.

# Produção
NODE_ENV=production
PORT=3000
# Só aceita conexões do próprio servidor (o acesso público é pelo túnel da Cloudflare)
HOST=127.0.0.1

# Sessão (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Twitch (dev.twitch.tv > Applications)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Ex.: https://seudominio.com.br/auth/twitch/callback
TWITCH_REDIRECT_URI=
# 64 caracteres hexadecimais (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ATENÇÃO: use a MESMA chave de hoje, senão os tokens do canal salvos no banco não abrem
TWITCH_TOKEN_ENCRYPTION_KEY=
# ID numérico da sua conta da Twitch (administrador)
ADMIN_TWITCH_ID=

# StreamElements (dashboard > Account > Channels > JWT Token)
STREAMELEMENTS_JWT=
