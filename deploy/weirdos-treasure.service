# Mantém o site ligado no servidor (reinicia sozinho se cair e ao ligar a máquina).
# Instalar:
#   sudo cp deploy/weirdos-treasure.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now weirdos-treasure
# Ver o log:
#   journalctl -u weirdos-treasure -f

[Unit]
Description=Weirdo's Treasure
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/weirdos-treasure
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# Proteções básicas do sistema
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/weirdos-treasure

[Install]
WantedBy=multi-user.target
